+# 检查输出必须含 14 个唯一项目。warn 项允许继续，缺项和未知状态一律阻断。
+validate_audit_output() {
+    local output="$1" total key row state line prefix found problems="" expected=14
+    local -a keys=("代理内核" "TUN网卡" "出口IP" "IP一致" "时区" "地区" "IPv6" "DNS" \
+        "WebRTC" "保镖" "规则置顶" "客户端语言" "ASN属性" "生态可达性")
+    total=0
+    while IFS= read -r line; do
+        [ -z "$line" ] && continue
+        [[ "$line" == \#* ]] && continue
+        total=$((total + 1))
+    done <<< "$output"
+    [ "$total" -eq "$expected" ] || problems="审计行数异常($total/$expected)"
+    for key in "${keys[@]}"; do
+        row=""; found=0
+        while IFS= read -r line; do
+            [ -z "$line" ] && continue
+            [[ "$line" == \#* ]] && continue
+            prefix=${line%%=*}
+            if [ "$prefix" = "$key" ]; then row="$line"; found=$((found + 1)); fi
+        done <<< "$output"
+        if [ "$found" -ne 1 ]; then
+            problems="${problems:+$problems; }缺少或重复检查项:$key"
+            continue
+        fi
+        state=${row#*=}
+        state=${state%%:*}
+        case "$state" in
+            ok) ;;
+            warn)
+                case "$key" in
+                    IP一致|ASN属性) ;;
+                    *) problems="${problems:+$problems; }不允许的警告:$key" ;;
+                esac ;;
+            *) problems="${problems:+$problems; }$key=${state:-未知状态}" ;;
+        esac
+    done
+    AUDIT_ERRORS="$problems"
+    [ -z "$problems" ]
+}
+
+# Claude 启动前必须收到完整的 14 项审计结果。
+launch_preflight() {
+    local output
+    output=$(checkdetail 2>&1)
+    printf '%s\n' "$output"
+    if ! validate_audit_output "$output"; then
+        echo "FAIL:启动被阻止，环境审计未通过：$AUDIT_ERRORS"
+        return 1
+    fi
+    echo "OK:14项环境审计通过"
 }
 
