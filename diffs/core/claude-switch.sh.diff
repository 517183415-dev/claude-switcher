+# 国家与时区优先从 ipinfo 获取;遇到限流或无效响应时回退到 ipwho.is。
+lookup_geo() {
+    local url payload fields
+    for url in https://ipinfo.io/json https://ipwho.is/ https://api.ip.sb/geoip; do
+        payload=$(curl -fsS --max-time 8 "$url" 2>/dev/null) || continue
+        fields=$(printf '%s' "$payload" | python3 -c '
+import json, sys
+import ipaddress
+try:
+    data = json.load(sys.stdin)
+    country = data.get("country_code") or data.get("country") or ""
+    zone = data.get("timezone") or ""
+    if isinstance(zone, dict):
+        zone = zone.get("id", "")
+    address = data.get("ip") or ""
+    ipaddress.ip_address(address)
+    if len(country) == 2 and zone:
+        print(country + "\t" + zone + "\t" + address)
+except Exception:
+    pass
+' 2>/dev/null)
+        if [ -n "$fields" ]; then printf '%s\n' "$fields"; return 0; fi
+    done
+    return 1
+}
+
+# Cloudflare trace 优先;不可达时用已校验的地理服务结果提供出口 IP 与国家。
+lookup_egress() {
+    local trace address country geo zone
+    trace=$(curl -fsS --max-time 8 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null) || trace=""
+    address=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p' | head -1)
+    country=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p' | head -1)
+    if [ -n "$address" ] && [[ "$country" =~ ^[A-Z]{2}$ ]]; then
+        printf '%s\t%s\n' "$address" "$country"
+        return 0
+    fi
+    geo=$(lookup_geo) || return 1
+    IFS=$'\t' read -r country zone address <<< "$geo"
+    [ -n "$address" ] && [[ "$country" =~ ^[A-Z]{2}$ ]] || return 1
+    printf '%s\t%s\n' "$address" "$country"
+}
