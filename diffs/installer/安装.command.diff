+# 国家与时区优先从 ipinfo 获取;遇到限流或无效响应时回退到 ipwho.is。
+lookup_geo() {
+    local url payload fields
+    for url in https://ipinfo.io/json https://ipwho.is/ https://api.ip.sb/geoip; do
+        payload=$(curl -fsS --max-time 8 "$url" 2>/dev/null) || continue
+        fields=$(printf '%s' "$payload" | python3 -c '
+import json, sys
+try:
+    data = json.load(sys.stdin)
+    country = data.get("country_code") or data.get("country") or ""
+    zone = data.get("timezone") or ""
+    if isinstance(zone, dict):
+        zone = zone.get("id", "")
+    if len(country) == 2 and zone:
+        print(country + "\t" + zone)
+except Exception:
+    pass
+' 2>/dev/null)
+        if [ -n "$fields" ]; then printf '%s\n' "$fields"; return 0; fi
+    done
+    return 1
+}
