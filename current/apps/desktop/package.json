{
  "name": "claude-switcher-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {"node": "26.8.2", "npm": "11.19.1"},
  "scripts": {
    "types": "cargo run --manifest-path ../../Cargo.toml -p switcher-domain --bin export-types",
    "test": "node --test tests/*.test.mjs && node scripts/core-preparation-regression.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "VITE_EDITION=${VITE_EDITION:-personal} vite build",
    "dev": "VITE_EDITION=${VITE_EDITION:-personal} vite --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {"@tauri-apps/api": "2.12.4", "svelte": "5.57.2"},
  "devDependencies": {"@sveltejs/vite-plugin-svelte": "7.3.1", "@tauri-apps/cli": "2.12.4", "svelte-check": "4.7.7", "typescript": "6.0.3", "vite": "8.3.5"}
}
