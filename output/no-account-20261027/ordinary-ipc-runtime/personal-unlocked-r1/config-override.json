{
  "productName": "Claude 切换器 Personal",
  "identifier": "local.claudeswitcher.personal",
  "app": {
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "personal-operations",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-ad-draft-read",
            "allow-ad-draft-save",
            "allow-import-ad-image",
            "allow-ad-image-preview",
            "allow-publisher-status",
            "allow-publish-ad",
            "allow-publisher-remote-read",
            "allow-publisher-remote-save",
            "allow-publisher-remote-select",
            "allow-pause-ad",
            "allow-restore-ad-history",
            "allow-create-ad-signing-key",
            "allow-export-publisher-backup",
            "allow-restore-publisher-backup",
            "allow-open-publisher-backup-folder",
            "allow-preview-publisher-cleanup",
            "allow-commit-publisher-cleanup",
            "allow-preview-publisher-gc",
            "allow-commit-publisher-gc",
            "allow-publisher-recovery-prepare",
            "allow-publisher-recovery-confirm",
            "allow-publisher-recovery-cancel",
            "allow-publisher-archive-import",
            "allow-publisher-retained-list",
            "allow-publisher-retained-export"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "IPC Remote",
        "url": "http://127.0.0.1:50998/",
        "width": 900,
        "height": 600
      },
      {
        "label": "other",
        "title": "IPC Other",
        "url": "index.html",
        "width": 900,
        "height": 600
      }
    ]
  },
  "build": {
    "frontendDist": "/Users/gua/CodexWorkspaces/claude-switcher/output/no-account-20261027/ordinary-ipc-runtime/personal-unlocked-r1/dist"
  }
}
