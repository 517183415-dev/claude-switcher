(version 1)
(allow default)
(deny network*)
(allow network-bind (local ip "*:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny file-read* file-write* (subpath "/Users/gua/Library"))
(deny file-read* file-write* (subpath "/Users/gua/.claude"))
(deny file-read* file-write* (subpath "/Users/gua/.claude-switcher"))
(deny file-read* file-write* (subpath "/Users/gua/.ssh"))
(deny file-read* file-write* (subpath "/Users/gua/.aws"))
(deny file-read* file-write* (subpath "/Users/gua/.config"))
(deny file-read* file-write* (subpath "/Library/Keychains"))
(deny file-read* file-write* (subpath "/Library/Application Support/claude-switcher"))
(deny file-read* file-write* (subpath "/Library/PrivilegedHelperTools"))
(deny file-read* file-write* (subpath "/Users/gua/.local/bin"))
(deny file-read* file-write* (literal "/Users/gua/.claude.json"))
(deny file-read* file-write* (literal "/Users/gua/.cargo/credentials"))
(deny file-read* file-write* (literal "/Users/gua/.cargo/credentials.toml"))
(deny file-write* (subpath "/Applications"))
(deny file-write* (subpath "/Library/LaunchDaemons"))
(deny file-write* (subpath "/Library/LaunchAgents"))
(deny file-write* (subpath "/usr/local/bin"))
(deny file-write* (subpath "/opt/homebrew/bin"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/.git"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/output/review"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/output/packaging-validation-20261026"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/docs/acceptance/evidence"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/docs/review-pack"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/docs/review-pack-gemini"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/docs/review-pack-jimmy"))
(deny mach-lookup (regex ".*[Cc]laude.*"))
(deny process-exec (literal "/usr/sbin/sysctl"))
(deny process-exec (literal "/usr/sbin/systemsetup"))
(deny process-exec (literal "/usr/sbin/networksetup"))
(deny process-exec (literal "/usr/sbin/scutil"))
(deny process-exec (literal "/sbin/route"))
(deny process-exec (literal "/sbin/ifconfig"))
(deny process-exec (literal "/usr/bin/defaults"))
(deny process-exec (literal "/usr/bin/pgrep"))
(deny process-exec (literal "/bin/ps"))
(deny process-exec (literal "/bin/launchctl"))
(deny process-exec (literal "/usr/bin/security"))
(deny process-exec (literal "/usr/bin/osascript"))
(deny process-exec (literal "/usr/bin/open"))
(deny process-exec (literal "/usr/bin/curl"))
(deny process-exec (literal "/usr/bin/sudo"))
(deny process-exec (literal "/usr/bin/killall"))
