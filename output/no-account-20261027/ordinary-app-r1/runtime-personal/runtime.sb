(version 1)
(allow default)
(deny network*)
(deny file-read* (subpath "/Users/gua"))
(deny file-read* (subpath "/Users/gua"))
(allow file-read* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/output/no-account-20261027/ordinary-app-r1"))
(allow file-read* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/apps/desktop/tests/native-ipc-business"))
(allow file-read-metadata (literal "/") (literal "/Users") (literal "/Users/gua") (literal "/Users/gua/CodexWorkspaces") (literal "/Users/gua/CodexWorkspaces/claude-switcher") (literal "/Users/gua/CodexWorkspaces/claude-switcher/apps") (literal "/Users/gua/CodexWorkspaces/claude-switcher/apps/desktop") (literal "/Users/gua/CodexWorkspaces/claude-switcher/apps/desktop/tests") (literal "/Users/gua/CodexWorkspaces/claude-switcher/output") (literal "/Users/gua/CodexWorkspaces/claude-switcher/output/no-account-20261027"))
(deny file-write*)
(allow file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/output/no-account-20261027/ordinary-app-r1/runtime-personal") (literal "/dev/null"))
(deny file-write* (subpath "/Applications"))
(deny file-write* (subpath "/Library/LaunchDaemons"))
(deny file-write* (subpath "/Library/LaunchAgents"))
(deny file-write* (subpath "/usr/local/bin"))
(deny file-write* (subpath "/opt/homebrew/bin"))
(deny file-write* (subpath "/Users/gua/CodexWorkspaces/claude-switcher/.git"))
(deny file-read* file-write* (subpath "/Users/gua/Library"))
(deny file-read* file-write* (subpath "/Users/gua/.claude"))
(deny file-read* file-write* (subpath "/Users/gua/.claude.json"))
(deny file-read* file-write* (subpath "/Users/gua/.claude-switcher"))
(deny file-read* file-write* (subpath "/Users/gua/.ssh"))
(deny file-read* file-write* (subpath "/Users/gua/.aws"))
(deny file-read* file-write* (subpath "/Users/gua/.config"))
(deny file-read* file-write* (subpath "/Users/gua/.cargo/credentials"))
(deny file-read* file-write* (subpath "/Users/gua/.cargo/credentials.toml"))
(deny file-read* file-write* (subpath "/Users/gua/.cargo/config"))
(deny file-read* file-write* (subpath "/Users/gua/.cargo/config.toml"))
(deny file-read* file-write* (subpath "/Users/gua/.local/bin"))
(deny file-read* file-write* (subpath "/Users/gua/Applications/Claude.app"))
(deny file-read* file-write* (subpath "/Library/Keychains"))
(deny file-read* file-write* (subpath "/Library/PrivilegedHelperTools"))
(deny file-read* file-write* (subpath "/Library/Application Support/claude-switcher"))
(deny file-read* file-write* (subpath "/Applications/Claude.app"))
(deny mach-lookup (regex #".*securityd.*") (regex #"(?i).*(claude|anthropic|switcher.*helper).*"))
(deny process-exec (regex #".*/(security|launchctl|open|osascript|sysctl|systemsetup|networksetup|route|ifconfig|scutil|sudo|curl|defaults|pgrep|ps|killall)$") (literal "/usr/bin/true"))
