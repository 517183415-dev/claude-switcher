{
  "identifier": "local.switcher.ipcbusiness.personal",
  "build": {
    "frontendDist": "../tests/native-ipc-business"
  },
  "app": {
    "windows": [
      {
        "label": "ipc-business",
        "title": "日志业务 IPC 隔离验证",
        "width": 640,
        "height": 360,
        "incognito": true,
        "url": "index.html"
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "ipc-business",
          "windows": [
            "ipc-business"
          ],
          "permissions": [
            "allow-activity-log",
            "allow-export-activity",
            "allow-ipc-business-info",
            "allow-ipc-business-finish",
            "allow-save-preferences",
            "allow-ipc-business-preferences-snapshot",
            "allow-ipc-business-backup-export",
            "allow-ipc-business-backup-restore",
            "allow-ad-draft-read",
            "allow-ad-draft-save",
            "allow-pause-ad",
            "allow-ipc-business-draft-snapshot",
            "allow-import-ad-image",
            "allow-ad-image-preview",
            "allow-ipc-business-publish-init",
            "allow-ipc-business-publish",
            "allow-publisher-status",
            "allow-restore-ad-history",
            "allow-preview-publisher-cleanup",
            "allow-commit-publisher-cleanup",
            "allow-preview-publisher-gc",
            "allow-commit-publisher-gc"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
